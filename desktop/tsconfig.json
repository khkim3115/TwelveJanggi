{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "node16",
    "moduleResolution": "node16"
  },
  "include": ["main.js", "lib/**/*.cjs", "smoke/**/*.cjs", "scripts/**/*.cjs"]
}
